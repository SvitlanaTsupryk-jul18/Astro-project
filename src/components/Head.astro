---
import '../styles/general.css';
import { Font } from 'astro:assets';

const { title, description, ogImage, ogType = 'product' } = Astro.props;

const canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : null;

const basePath = import.meta.env.BASE_URL.replace(/\/+$/, '');

// Social preview image: social networks need an absolute URL, base path
// included. A page may pass its own image path (relative to the site root).
const ogImageURL = new URL(`${basePath}${ogImage ?? '/static/images/og.jpg'}`, Astro.site);
---

<meta charset="UTF-8">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<Font cssVariable="--font-fixel-text" preload={[{ weight: '400' }]} />
<Font cssVariable="--font-jetbrains-mono" />
<title>{title}</title>
<meta name="description" content={description}>
<meta name="og:title" property="og:title" content={title}>
<meta name="og:type" property="og:type" content={ogType}>
<meta name="og:description" property="og:description" content={description}>
<meta name="og:image" property="og:image" content={ogImageURL}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Checkbox — впевненість у кожному чеку">
<meta name="twitter:card" content="summary_large_image">
{canonicalURL && <meta name="og:url" property="og:url" content={String(canonicalURL)}>}
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f1deed">
<meta name="apple-mobile-web-app-status-bar-style" content="#f1deed">
{/* unreleased redesign of a real brand's site: kept out of search results so
    it never competes with the official checkbox.ua */}
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`.replace("//", "/")} type="image/x-icon"/>
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`.replace("//", "/")}/>
{canonicalURL && <link rel="canonical" href={String(canonicalURL)}/>}