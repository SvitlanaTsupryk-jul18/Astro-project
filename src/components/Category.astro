---
import DottedBorder from "@components/DottedBorder.astro";
import { getImage } from "astro:assets";
import ArrowRightWhite from "@assets/icons/arrow-right-white.svg";
import IconCategoryRetail from "@assets/icons/category-retail.svg";
import IconCategoryNetwork from "@assets/icons/category-network.svg";
import IconCategoryMarketplace from "@assets/icons/category-marketplace.svg";
import IconCategoryEcommerce from "@assets/icons/category-ecommerce.svg";
import IconCategoryHospitality from "@assets/icons/category-hospitality.svg";
import IconCategoryMedical from "@assets/icons/category-medical.svg";
import IconCategoryBeauty from "@assets/icons/category-beauty.svg";
import IconCategorySport from "@assets/icons/category-sport.svg";
import IconCategoryPawnshop from "@assets/icons/category-pawnshop.svg";
import IconCategoryExchange from "@assets/icons/category-exchange.svg";
import IconCategoryFranchise from "@assets/icons/category-franchise.svg";
import IconCategoryVending from "@assets/icons/category-vending.svg";
import IconCategoryMall from "@assets/icons/category-mall.svg";
import IconCategoryCourier from "@assets/icons/category-courier.svg";
import { $image } from "@utils/assets";
import "@styles/components/category.css";

// Category slider: left-hand tabs cycle automatically and the right-hand
// panel (photo + quote + client logos) fades to match. Every category has
// its own quote; the photos are shared placeholders for now (one per four
// categories) until each vertical gets its own shot.
const categoryPhotos = [
  $image("/category-1.png"),
  $image("/category-2.png"),
  $image("/category-3.png"),
  $image("/category-4.png"),
];

// The category panel swaps its <img> from data-* attributes via JS, which
// bypasses <Image> — so pre-optimize the panel photos with getImage() here
// and put the optimized URLs (webp + srcset) into those attributes instead.
const categoryPanelSizes = "(min-width: 1024px) 50vw, 100vw";

const optimizedCategoryPhotos = await Promise.all(
  categoryPhotos.map((src) =>
    getImage({
      src,
      format: "webp",
      widths: [700, 1400],
      sizes: categoryPanelSizes,
    })
  )
);

const categories = [
  {
    icon: IconCategoryRetail,
    label: "Класичний рітейл",
    quote:
      "Перейшли з двох старих касових апаратів за один вечір. Більше ніяких опломбувань і сервісних центрів, а виручку бачу з телефона навіть у відпустці.",
    author: "Олена",
    role: "власниця, магазин «Комора»",
    logos: ["Комора", "Лавка 24", "Господар", "Домівка"],
  },
  {
    icon: IconCategoryNetwork,
    label: "Мережам магазинам",
    quote:
      "У нас 37\u00a0точок по всій країні. Усі каси в одному кабінеті, а нову точку запускаємо за день, а не за тиждень, як раніше.",
