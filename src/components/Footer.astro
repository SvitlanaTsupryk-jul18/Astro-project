            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="41"
              height="16"
              viewBox="0 0 41 16"
              fill="none"
            >
              <path
                d="M19.3793 7.80013V12.4786H17.8422V0.908214H21.8385C22.8119 0.908214 23.7341 1.26036 24.4514 1.91433C25.1687 2.518 25.5273 3.42351 25.5273 4.37932C25.5273 5.33514 25.1687 6.19034 24.4514 6.84432C23.7341 7.49829 22.8632 7.85043 21.8385 7.85043L19.3793 7.80013ZM19.3793 2.31678V6.34126H21.941C22.5045 6.34126 23.0681 6.14003 23.4267 5.73759C24.2465 4.983 24.2465 3.72535 23.478 2.97076L23.4267 2.92045C23.0169 2.518 22.5045 2.26647 21.941 2.31678H19.3793Z"
                fill="white"></path>
              <path
                d="M29.0625 4.32902C30.1896 4.32902 31.0606 4.63085 31.7267 5.23453C32.3927 5.8382 32.7001 6.64309 32.7001 7.64921V12.4786H31.2655V11.3719H31.2143C30.5995 12.2774 29.7285 12.7301 28.7038 12.7301C27.8329 12.7301 27.0644 12.4786 26.4495 11.9755C25.886 11.4725 25.5273 10.7682 25.5273 10.0136C25.5273 9.2087 25.8347 8.55472 26.4495 8.05166C27.0644 7.5486 27.9353 7.34738 28.96 7.34738C29.8822 7.34738 30.5995 7.49829 31.1631 7.85043V7.49829C31.1631 6.99523 30.9581 6.49217 30.5483 6.19034C30.1384 5.8382 29.6261 5.63697 29.0625 5.63697C28.1915 5.63697 27.5255 5.98911 27.0644 6.6934L25.7323 5.8885C26.552 4.83208 27.6279 4.32902 29.0625 4.32902ZM27.1156 10.0639C27.1156 10.4663 27.3205 10.8185 27.6279 11.0197C27.9866 11.2712 28.3964 11.4222 28.8063 11.4222C29.4211 11.4222 30.0359 11.1706 30.497 10.7179C31.0094 10.2651 31.2655 9.71176 31.2655 9.10808C30.8044 8.75594 30.1384 8.55472 29.2674 8.55472C28.6526 8.55472 28.1403 8.70564 27.7304 9.00747C27.3205 9.259 27.1156 9.61114 27.1156 10.0639Z"
                fill="white"></path>
              <path
                d="M41 4.58055L35.9278 16H34.3908L36.2865 12.0258L32.9563 4.63085H34.5958L37.0037 10.3154H37.055L39.4118 4.63085H41V4.58055Z"
