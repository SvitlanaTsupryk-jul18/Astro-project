                <path
                  d="M7.12967 2.0628C6.67264 2.60324 5.94139 3.0295 5.21014 2.9686C5.11874 2.23787 5.47675 1.46147 5.89569 0.981922C6.35272 0.426261 7.15253 0.0304472 7.79999 0C7.87616 0.76118 7.57909 1.50714 7.12967 2.0628ZM7.79237 3.11323C6.73358 3.05233 5.82714 3.71456 5.3244 3.71456C4.81405 3.71456 4.04471 3.14367 3.20682 3.1589C2.11757 3.17412 1.10448 3.79068 0.548425 4.7726C-0.594153 6.73644 0.251355 9.64415 1.35585 11.2426C1.89667 12.0343 2.54413 12.902 3.39725 12.8716C4.20468 12.8411 4.5246 12.3463 5.4996 12.3463C6.48221 12.3463 6.76405 12.8716 7.61718 12.8563C8.50077 12.8411 9.05682 12.0647 9.59764 11.2731C10.2146 10.3749 10.466 9.49952 10.4812 9.45385C10.466 9.43863 8.77499 8.79163 8.75975 6.84301C8.74452 5.21408 10.0928 4.43768 10.1537 4.39201C9.39198 3.26546 8.2037 3.14367 7.79237 3.11323ZM13.909 0.905804V12.7726H15.7523V8.71551H18.3041C20.6349 8.71551 22.2726 7.11703 22.2726 4.80304C22.2726 2.48906 20.6654 0.905804 18.365 0.905804H13.909ZM15.7523 2.45861H17.8775C19.4771 2.45861 20.3912 3.31113 20.3912 4.81066C20.3912 6.31018 19.4771 7.17031 17.8699 7.17031H15.7523V2.45861ZM25.6394 12.8639C26.7973 12.8639 27.8713 12.2778 28.3588 11.3492H28.3969V12.7726H30.1031V6.86584C30.1031 5.15319 28.732 4.04948 26.6221 4.04948C24.6644 4.04948 23.2172 5.16841 23.1639 6.70599H24.8244C24.9615 5.97526 25.6394 5.49572 26.5687 5.49572C27.6961 5.49572 28.3283 6.02093 28.3283 6.98763V7.64225L26.0279 7.77926C23.8875 7.90866 22.7297 8.78401 22.7297 10.3064C22.7297 11.844 23.9256 12.8639 25.6394 12.8639ZM26.1346 11.4558C25.1519 11.4558 24.5273 10.9838 24.5273 10.2607C24.5273 9.51475 25.1291 9.08088 26.2793 9.01237L28.3283 8.88297V9.55281C28.3283 10.6641 27.3838 11.4558 26.1346 11.4558ZM32.3807 16C34.1783 16 35.0238 15.3149 35.7627 13.2369L39 4.16365H37.1262L34.9553 11.1741H34.9172L32.7463 4.16365H30.8191L33.9422 12.803L33.7746 13.3283C33.4928 14.2188 33.0357 14.5614 32.2207 14.5614C32.076 14.5614 31.7941 14.5461 31.6799 14.5309V15.9543C31.7865 15.9848 32.2435 16 32.3807 16Z"
                  fill="white"></path>
              </g>
