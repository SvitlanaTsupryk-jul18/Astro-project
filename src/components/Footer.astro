              <path
                d="M6.7757 2.61862C7.74914 2.61862 8.67135 2.97076 9.38863 3.62473L11.3355 1.71311C10.1059 0.606378 8.46642 -0.0475994 6.82693 0.00270653C4.26523 0.00270653 1.90847 1.41127 0.781318 3.67504L3.03561 5.38544C3.49672 3.77565 5.03374 2.61862 6.7757 2.61862Z"
                fill="#EA4335"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="footer-group">
        <DottedBorder color="#fff" />
        <p class="footer-group-title">
          Ми є частиною <img
            src={LogoCheckboxGroup.src}
            width={LogoCheckboxGroup.width}
            height={LogoCheckboxGroup.height}
            alt="Checkbox Group"
            decoding="async"
          />
        </p>
        <p class="footer-group-desc">
          українська група FinTech-компаній та бізнес-екосистема, що швидко
          зростає:
        </p>
        <div class="footer-group-brands">
          {
            groupBrands.map((group) => (
              <a href={group.link}>
                <img
                  src={group.logo.src}
                  width={group.logo.width}
                  height={group.logo.height}
                  alt={group.name}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-nav">
      {
        columns.map((column) => (
          <div class="footer-col">
            {navGroups
              .filter((group) => group.column === column)
              .map((group) => (
                <div class="footer-nav-group">
                  <button
                    type="button"
                    class="footer-nav-toggle"
                    aria-expanded="false"
                  >
                    {group.title}
                    <svg
                      class="footer-chevron"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                    >
                      <path
                        d="M11.9983 13.1704L16.9481 8.2207L18.3623 9.63491L11.9983 15.9989L5.6344 9.63491L7.04861 8.2207L11.9983 13.1704Z"
                        fill="white"
                      />
                    </svg>
                  </button>
                  <div class="footer-nav-content">
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          {item === "Блог" ? (
                            <a href={blogUrl} target="_blank" rel="noopener">
                              {item}
                            </a>
                          ) : (
                            <a href={base}>{item}</a>
                          )}
                        </li>
                      ))}
                    </ul>
