const groupBrands = [
  { link: base, name: "Checkbox", logo: LogoCheckbox },
  { link: base, name: "Posbox", logo: LogoPosbox },
  { link: base, name: "Edibox", logo: LogoEdibox },
  { link: base, name: "Taxbox", logo: LogoTaxbox },
];

const contactLinks = [
  "Служба турботи",
  "Відділ продажів",
  "Ставайте партнером Чекбокса",
  "Запишіться на демо",
];
const contactPhone = "0\u00a0800\u00a0330\u00a0676";
const legalLinks = [
  "Політика конфіденційності",
  "Публічна оферта",
  "Посередництво",
];

// Nav groups in mobile (accordion) order; `column` places them in the desktop grid
const navGroups = [
  {
    column: 1,
    title: "Продукти",
    items: [
      "Цифрова каса",
      "Еквайринг",
      "КЕП для касира",
      "Кредитування для бізнесу",
      "Обладнання",
    ],
  },
  {
    column: 1,
