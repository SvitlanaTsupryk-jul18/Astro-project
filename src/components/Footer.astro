    icon: `<svg xmlns="http://w3.org" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9.8 15.4286L15.509 12L9.8 8.57143V15.4286ZM22.516 6.48C22.659 7.01714 22.758 7.73714 22.824 8.65143C22.901 9.56571 22.934 10.3543 22.934 11.04L23 12C23 14.5029 22.824 16.3429 22.516 17.52C22.241 18.5486 21.603 19.2114 20.613 19.4971C20.096 19.6457 19.15 19.7486 17.698 19.8171C16.268 19.8971 14.959 19.9314 13.749 19.9314L12 20C7.391 20 4.52 19.8171 3.387 19.4971C2.397 19.2114 1.759 18.5486 1.484 17.52C1.341 16.9829 1.242 16.2629 1.176 15.3486C1.099 14.4343 1.066 13.6457 1.066 12.96L1 12C1 9.49714 1.176 7.65714 1.484 6.48C1.759 5.45143 2.397 4.78857 3.387 4.50286C3.904 4.35429 4.85 4.25143 6.302 4.18286C7.732 4.10286 9.041 4.06857 10.251 4.06857L12 4C16.609 4 19.48 4.18286 20.613 4.50286C21.603 4.78857 22.241 5.45143 22.516 6.48Z" fill="currentColor"/></svg>`,
