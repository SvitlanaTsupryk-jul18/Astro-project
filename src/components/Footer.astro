      "Ентерпрайзу",
      "Класичному рітейлу",
      "Мережам",
      "Торговцям на маркетплейсах",
      "Інтернет-магазинам",
      "Ресторанам і готелям",
      "Медичним центрам",
      "Краса та догляд",
      "Спортивним клубам",
      "Ломбардам",
      "Обмінникам валют",
      "Франшизам",
      "Вендінг",
      "ТРЦ",
      "Платформам (доставка, таксі)",
    ],
  },
  {
    column: 3,
    title: "Порівняння",
    items: [
      "Вчасно.Каса",
      "Приват Каса",
      "Poster",
      "ПРРО від Податкової",
      "Cashalot",
      "CashDesk",
      "є-Чек",
      "Вебчек",
      "ПРРО від Skyservice",
    ],
  },
  {
    column: 3,
    title: "Матеріали",
    items: [
      "API документація",
      "Текстові інструкції",
      "Відеогайди",
      "Блог",
      "Історії клієнтів",
    ],
  },
  {
    column: 4,
    title: "Компанія",
    items: ["Про нас", "Клієнти", "Для преси", "Вакансії", "Новини"],
  },
  { column: 4, title: "Контакти", items: contactLinks, isContacts: true },
];

const columns = [1, 2, 3, 4];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <a href={base} aria-label="Checkbox">
          <LogoWhite />
        </a>
        <p class="footer-text">
          <strong>Чекбокс — турботливий провайдер цифрових кас.</strong>
          Допомагаємо сотням тисяч українських бізнесів впевнено торгувати, не відволікаючись
          на зайву бюрократію та страх перед податковою.
        </p>
        <div class="footer-socials">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                class="footer-social"
              >
                <DottedBorder
                  color="rgba(255, 255, 255, 0.48)"
                  gap={2}
                  radius={8}
                />
                <Fragment set:html={social.icon} />
              </a>
            ))
          }
        </div>
        <div class="footer-payments">
          <div class="footer-payment">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="40"
              height="12"
              viewBox="0 0 40 12"
              fill="none"
            >
              <g clip-path="url(#clip0_10755_7391)">
                <path
                  d="M26.0476 0.0175781C23.2104 0.0175781 20.6748 1.37658 20.6748 3.88687C20.6748 6.76601 25.1716 6.96485 25.1716 8.41144C25.1716 9.02054 24.4164 9.56569 23.126 9.56569C21.2952 9.56569 19.9268 8.80395 19.9268 8.80395L19.3412 11.3375C19.3412 11.3375 20.9176 11.981 23.0104 11.981C26.1124 11.981 28.5536 10.5555 28.5536 8.00193C28.5536 4.95943 24.038 4.7665 24.038 3.42413C24.038 2.94699 24.658 2.42438 25.9444 2.42438C27.396 2.42438 28.58 2.9784 28.58 2.9784L29.1532 0.531684C29.1532 0.531684 27.8644 0.0175781 26.0472 0.0175781H26.0476ZM0.088789 0.202375L0.019989 0.571601C0.019989 0.571601 1.21359 0.773399 2.28879 1.17626C3.67319 1.63788 3.77159 1.90695 4.00479 2.74149L6.54519 11.7903H9.95079L15.1972 0.202375H11.7996L8.42839 8.08103L7.05279 1.40245C6.92679 0.638128 6.28759 0.202006 5.50559 0.202006H0.089189L0.088789 0.202375ZM16.5636 0.202375L13.8984 11.7903H17.1384L19.794 0.202375H16.5636ZM34.634 0.202375C33.8528 0.202375 33.4388 0.588971 33.1352 1.26422L28.3884 11.7903H31.786L32.4432 10.0358H36.5824L36.982 11.7903H39.98L37.3648 0.202375H34.634ZM35.076 3.33321L36.0832 7.68149H33.3852L35.0764 3.33321H35.076Z"
                  fill="white"></path>
              </g>
              <defs>
                <clipPath id="clip0_10755_7391">
                  <rect width="40" height="12" fill="white"></rect>
                </clipPath>
              </defs>
            </svg>
          </div>
          <div class="footer-payment">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="26"
              height="16"
              viewBox="0 0 26 16"
              fill="none"
            >
              <path
                d="M16.5076 1.71133H9.47158V14.2887H16.5076V1.71133Z"
