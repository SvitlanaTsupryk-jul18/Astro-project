---
import LogoWhite from "@assets/icons/logo-white.svg";
import DottedBorder from "@components/DottedBorder.astro";
import LogoCheckbox from "@assets/icons/brands/checkbox.svg";
import LogoPosbox from "@assets/icons/brands/posbox.svg";
import LogoEdibox from "@assets/icons/brands/edibox.svg";
import LogoTaxbox from "@assets/icons/brands/taxbox.svg";
import LogoCheckboxGroup from "@assets/icons/brands/checkbox-group.svg";

const year = new Date().getFullYear();
// Prefix internal links with the configured base path (see astro.config.mjs)
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Portfolio piece: footer links lead back to the landing page; only the
// blog opens Checkbox's real blog
const blogUrl = "https://checkbox.ua/blog/";


const socialLinks = [
  {
