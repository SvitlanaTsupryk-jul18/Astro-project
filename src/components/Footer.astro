                fill="#4285F4"></path>
              <path
                d="M6.7757 13.2835C8.62012 13.2835 10.1571 12.6798 11.2843 11.6737L9.08123 10.0136C8.46642 10.416 7.69791 10.6676 6.7757 10.6676C5.03374 10.6676 3.49672 9.51053 2.98438 7.90074H0.730084V9.61114C1.90847 11.8749 4.214 13.2835 6.7757 13.2835Z"
                fill="#34A853"></path>
              <path
                d="M2.98438 7.90074C2.67698 7.09585 2.67698 6.19034 2.98438 5.33514V3.62474H0.730084C-0.243361 5.48606 -0.243361 7.69952 0.730084 9.61114L2.98438 7.90074Z"
