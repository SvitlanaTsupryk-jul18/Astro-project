  },
  {
    href: base,
    label: "Facebook",
    icon: `<svg xmlns="http://w3.org" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M13.4964 21V12.8027H16.458L16.8982 9.59326H13.4964V7.54894C13.4964 6.6228 13.7727 5.9887 15.1962 5.9887H17V3.12727C16.1224 3.03875 15.2402 2.99634 14.3575 3.00025C11.7397 3.00025 9.94237 4.49248 9.94237 7.23189V9.58726H7V12.7967H9.9488V21H13.4964Z" fill="currentColor"/></svg>`,
