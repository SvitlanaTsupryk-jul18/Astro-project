---
import BaseLayout from "@layouts/BaseLayout.astro";
import DottedBorder from "@components/DottedBorder.astro";
import Faq from "@components/Faq.astro";
import News from "@components/News.astro";
import Blog from "@components/Blog.astro";
import ClientLogos from "@components/ClientLogos.astro";
import Support from "@components/Support.astro";
import Features from "@components/Features.astro";
import Compare from "@components/Compare.astro";
import Steps from "@components/Steps.astro";
import Testimonials from "@components/Testimonials.astro";
import Reasons from "@components/Reasons.astro";
import Category from "@components/Category.astro";
import { Image } from "astro:assets";
import girlImage from "@assets/images/girl1@2x.png";
import ArrowRightWhite from "@assets/icons/arrow-right-white.svg";
import IconPlayDemo from "@assets/icons/play-demo.svg";
import ApiScheme from "@assets/images/scheme.svg";
import FaqBoy from "@assets/images/boy.svg";
import FaqCup from "@assets/images/cup.svg";

import HeroPattern from "@assets/images/hero-pattern.svg";
import IconApiPower from "@assets/icons/api/power.svg";
import IconApiCheckbox from "@assets/icons/api/checkbox.svg";
import IconApiSpark from "@assets/icons/api/spark.svg";
import ApiLineToError from "@assets/icons/api/line-to-error.svg";
import ApiLineFromError from "@assets/icons/api/line-from-error.svg";
import IconApiError from "@assets/icons/api/error.svg";
import IconApiCheck from "@assets/icons/api/check.svg";
import ApiLineFork from "@assets/icons/api/line-fork.svg";
import ApiLineMerge from "@assets/icons/api/line-merge.svg";
import IconApiReports from "@assets/icons/api/reports.svg";
import IconApiServiceReceipts from "@assets/icons/api/service-receipts.svg";
import IconApiWebhook from "@assets/icons/api/webhook.svg";
import IconApiShiftClose from "@assets/icons/api/shift-close.svg";
import ApiLogo from "@assets/icons/api/logo.svg";
import { $image } from "@utils/assets";
import "@styles/pages/index.css";

// Where links lead: it's a portfolio piece, so every call to action points
// back to this landing page
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Hero receipt counter: a known total at a fixed moment plus the average
// issuing rate. The build renders the value for build time so the first
// paint is already close; the client script then updates it to "now" and
// adds perSecond every second. Kyiv time offset is explicit so every
// visitor sees the same number.
const receiptCounter = {
  base: 2_582_509_485,
  baseAt: Date.parse("2026-07-20T00:00:00+03:00"),
  perSecond: 33,
};
// group digits with non-breaking spaces so the number never wraps
const formatCount = (n: number) =>
  String(n).replace(/\B(?=(\d{3})+(?!\d))/g, "\u00a0");
const receiptsAtBuild =
  receiptCounter.base +
  Math.floor((Date.now() - receiptCounter.baseAt) / 1000) * receiptCounter.perSecond;

// Statistics cards
const stats = [
  {
    icon: $image("/st-1.svg"),
    value: "100+ МЛН",
    caption: "чеків видаємо щомісяця",
  },
  { icon: $image("/st-2.svg"), value: "240+ ТИС", caption: "активних кас" },
  {
    icon: $image("/st-3.svg"),
    value: "38%",
    caption: "ПРРО на Чекбокс",
  },
  {
    icon: $image("/st-4.svg"),
    value: "740+ МЛРД",
    caption: "гривень виторгу в 2025",
  },
];

// FAQ section: answers hold inline HTML (paragraphs/lists), rendered with set:html
const faqItems = [
  {
    q: "Що таке PPO та ПРРО?",
    a: `<p>РРО (реєстратор розрахункових операцій) — це класичний фізичний касовий апарат або фіскальний принтер, що потребує купівлі обладнання та сервісного обслуговування, тоді як ПРРО (програмний РРО) — це сучасна цифрова альтернатива у вигляді програми або додатка на смартфон, планшет чи комп'ютер. Основна різниця полягає у форматі: РРО друкує паперові чеки за допомогою вбудованого заліза, а ПРРО реєструє операції на серверах податкової онлайн і видає електронні чеки (через QR-код або месенджери), що є значно дешевшим і швидшим рішенням для сучасного бізнесу.</p>`,
  },
  {
    q: "Кому потрібен касовий апарат?",
    a: `<p>До 01.01.2022 було не потрібно застосувати РРО (ПРРО) ФОП-єдинникам 1 групи у будь-якому випадку та II-IV групи, обсяг доходу яких протягом календарного року не перевищує 220 розмірів мінімальної заробітної плати (у 2021 році – 1&nbsp;320&nbsp;000&nbsp;грн), * крім видів діяльності у сферах з істотними ризиками ухилення від оподаткування, для яких РРО (ПРРО) вже було обов'язковим:</p>
<ul>
<li>реалізація технічно складних побутових товарів, що підлягають гарантійному ремонту;</li>
<li>реалізація лікарських засобів, виробів медичного призначення;</li>
<li>надання платних послуг у сфері охорони здоров'я;</li>
<li>реалізація ювелірних та побутових виробів з дорогоцінних металів, дорогоцінного каміння, дорогоцінного каміння органогенного утворення та напівдорогоцінного каміння.</li>
</ul>
<p>З 01.01.2022 використання РРО (ПРРО) обов'язкове для всіх ФОП 2-4 груп на єдиному податку.</p>`,
  },
  {
    q: "Коли треба видавати чек?",
    a: `<p>Коли є факт розрахункової операції: оплата платіжною карткою (на сайті чи через pos-термінал), готівкою, оплата та отримання товару на пошті.</p>`,
  },
  {
    q: "Який штраф, якщо немає касового апарату?",
    a: `<p>За роботу без РРО або ПРРО штраф складає 100% вартості проданих товарів чи послуг — якщо це перше порушення, і 150% вартості — за кожне наступне. З 1 серпня 2025 року штрафні санкції відновлено у повному розмірі.</p>`,
  },
  {
    q: "Що краще для бізнесу: придбати класичний РРО (касовий апарат) чи купити програмний РРО (ПРРО)?",
    a: `<p>Для більшості бізнесів вигідніший ПРРО. Класична каса коштує близько 15&nbsp;000&nbsp;грн і потребує обслуговування, опломбування та заміни щороку. ПРРО — це програма, яка встановлюється на будь-який смартфон, планшет чи комп'ютер: реєстрація займає один робочий день, щомісячна абонплата значно менша, а оновлення — безкоштовні. Крім того, ПРРО легко інтегрується з платіжними сервісами, CRM та іншими системами, видає електронні чеки й автоматично переходить в офлайн-режим під час відключення інтернету.</p>`,
  },
  {
    q: "Як правильно зняти з реєстрації РРО відповідно до чинного законодавства?",
    a: `<p>Зняття з реєстрації РРО відбувається у три кроки. Спочатку потрібно звернутися до ЦСО, з яким укладено договір на обслуговування, — вони проведуть розпломбування та нададуть довідку за формою №&nbsp;1-ЦСО. Після цього подається Заява про зняття з реєстрації за формою №&nbsp;4-РРО в Електронному кабінеті разом із реєстраційним посвідченням. Протягом п'яти календарних днів ДПС надішле довідку про скасування реєстрації за формою №&nbsp;6-РРО у спосіб, зазначений у заяві.</p>`,
  },
  {
    q: "Як зареєструвати програмний РРО?",
    a: `<p>Зареєструвати ПРРО можна через електронний кабінет на сайті ДПС або через платформу провайдера — наприклад, Checkbox. Для цього потрібні паспорт, ІПН, КЕП (електронний підпис), дані про торгову точку та касирів. Після реєстрації на сайті провайдера достатньо завантажити програмне забезпечення на будь-який пристрій — смартфон, планшет або комп'ютер — і каса готова до роботи.</p>`,
  },
  {
    q: "Чи можна встановити програмний РРО на декілька пристроїв?",
    a: `<p>Так, але працювати в один момент часу можна тільки на одному пристрої.</p>`,
  },
  {
    q: "Чи потрібно знімати з реєстрації апаратний РРО для використання програмного РРО?",
    a: `<p>Законодавчих обмежень немає – класичний і програмний РРО можуть працювати паралельно. Якщо ж ви вирішили використовувати лише програмну касу, реєстрацію звичайної каси треба скасувати.</p>`,
  },
  {
    q: "Можна при роботі з ПРРО видавати чеки тільки в електронному вигляді?",
    a: `<p>Так, але, якщо клієнт попросить паперовий чек, його необхідно надати.</p>`,
  },
  {
    q: "Скільки електронних печаток для підпису чеків треба реєструвати?",
    a: `<p>За допомогою одного сертифікату електронної печатки можна працювати одночасно тільки на одному ПРРО. У випадку одночасного використання кількох програмних кас, треба відповідна кількість зареєстрованих касирів і сертифікатів електронних печаток.</p>`,
  },
  {
    q: "У випадку відключення електроенергії чи інтернету, чи можна продовжувати роботу з програмною касою?",
    a: `<p>Якщо пропав тільки інтернет – ПРРО переходить в офлайн-режим і ви можете продовжити роботу.</p>
<p>Якщо немає світла – ви можете видавати чеки за допомогою мобільного додатку Checkbox.</p>`,
  },
];

---

<BaseLayout
  title="ПРРО Checkbox | Програмний РРО № 1 для бізнесу в Україні"
  description="Офіційний вебсайт Checkbox - програмного РРО для вашого бізнесу ✅ Безкоштовний 1 місяць користування ⏩ Швидка та зручна реєстрація через електронний кабінет."
  ogType="website"
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <p class="hero-stat">
          Чекбокс видав <b
            data-receipt-counter
            data-base={receiptCounter.base}
            data-base-at={receiptCounter.baseAt}
            data-per-second={receiptCounter.perSecond}
            >{formatCount(receiptsAtBuild)}</b
          > чеків
        </p>
        <h1>Впевненість<br />у кожному чеку</h1>
        <p class="hero-desc">
          Тримайте каси під контролем і зосереджуйтесь на продажах,<br /> замість
          бюрократії. <strong
            >З найбільшим провайдером цифрових кас<br /> (ПРРО) в Україні.</strong
          >
        </p>
        <div class="hero-actions">
          <a href={home} class="btn">
            Почніть безкоштовно
            <ArrowRightWhite />
          </a>
          <a href={home} class="btn btn--outline">
            <IconPlayDemo />
            Запишіться на демо
          </a>
        </div>
      </div>
      <div class="hero-image">
        <HeroPattern />
        <Image
          src={girlImage}
          width={545}
          height={562}
          widths={[400, 640, 800, 1090]}
          sizes="(min-width: 1024px) min(50vw, 700px), calc(100vw - 48px)"
          alt="Клієнтка Checkbox у футболці з логотипом компанії"
          fetchpriority="high"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <ClientLogos />

  <section class="container statistic">
    <h2 hidden>Statistic</h2>
    {
      stats.map((item, i) => (
        <div class="statistic-card">
          <p class="statistic-index">{String(i + 1).padStart(2, "0")} —</p>
          <Image
            src={item.icon}
            alt="icon"
            class="statistic-icon"
            loading="lazy"
          />
          <p class="statistic-value">{item.value}</p>
          <h3 class="statistic-caption">{item.caption}</h3>
        </div>
      ))
    }
  </section>

  <Features />

  <section class="container">
    <div class="banner">
      <h2>
        <span
          >Ми подбаємо, щоб каси просто працювали,<br />
          а ви</span
        > сміливо займалися бізнесом
      </h2>
    </div>
  </section>

  <Reasons />

  <Compare />

  <Steps />

  <section class="container">
    <div class="banner">
      <h2>
        От і все! <span
          >Контролюйте продажі та звітуйте зручно, <br />
          не відволікаючись на зайву бюрократію,
        </span><br />
        ми про неї потурбуємося.
      </h2>
    </div>
  </section>

  <Category />

  <Testimonials />

  <section class="api section-dark">
    <div class="container api-inner">
      <p class="subtitle">API</p>
      <h2>
        Потужне відкрите API<br />для унікальних<br /> інтеграцій
      </h2>
      <p class="api-text">
        Ми розуміємо, що ваш бізнес-процес наче сніжинка, іншого такого не
        існує.<br />
        Ми допоможемо вашій команді вбудувати Чекбокс, щоб усе працювало як слід.
      </p>
      <a href={home} class="api-link"
        >Перегляньте документацію <ArrowRightWhite /></a
      >
      <img
        src={ApiScheme.src}
        width={ApiScheme.width}
        height={ApiScheme.height}
        alt=""
        loading="lazy"
        decoding="async"
        class="api-scheme"
      />
      <div class="api-flow" aria-hidden="true">
        <div class="api-node">
          <DottedBorder color="#7A7A7A" gap={4} />
          <span class="api-badge api-badge--power">
            <IconApiPower />
          </span>
          <span class="api-ic">
            <IconApiCheckbox />
          </span>
          Каса Checkbox
        </div>
        <div class="api-node">
          <DottedBorder color="#7A7A7A" gap={4} />
          <span class="api-ic api-ic--num">1</span>
          Авторизація
        </div>
        <div class="api-node">
          <DottedBorder color="#7A7A7A" gap={4} />
          <span class="api-badge api-badge--spark">
            <IconApiSpark />
          </span>
          <span class="api-ic api-ic--num">2</span>
          Відкриття зміни
        </div>
        <div class="api-node api-node--branch">
          <DottedBorder color="#7A7A7A" gap={4} />
          <span class="api-ic api-ic--num">3</span>
          Створення чека
          <div class="api-card api-error">
            <DottedBorder color="#7A7A7A" gap={4} />
            <ApiLineToError />
            <ApiLineFromError />
            <span class="api-ic">
              <IconApiError />
            </span>
            <span class="api-card-body">
              <span class="api-card-label">Помилка?</span>
              <span class="api-card-sub">Перевірити статус</span>
            </span>
          </div>
        </div>
        <div class="api-node">
          <DottedBorder color="#7A7A7A" gap={4} />
          <span class="api-badge api-badge--check">
            <IconApiCheck />
          </span>
          <span class="api-ic api-ic--num">4</span>
          Чек готовий
        </div>
        <div class="api-row">
          <ApiLineFork />
          <ApiLineMerge />
          <div class="api-card">
            <DottedBorder color="#7A7A7A" gap={4} />
            <span class="api-ic">
              <IconApiReports />
            </span>
            <span class="api-card-body">
              <span class="api-card-label">Звіти</span>
              <span class="api-card-sub">X-звіт • Z-звіт</span>
            </span>
          </div>
          <div class="api-card">
            <DottedBorder color="#7A7A7A" gap={4} />
            <span class="api-ic">
              <IconApiServiceReceipts />
            </span>
            <span class="api-card-body">
              <span class="api-card-label">Сервісні чеки</span>
              <span class="api-card-sub">Внесення • вилучення готівки</span>
            </span>
          </div>
          <div class="api-card">
            <DottedBorder color="#7A7A7A" gap={4} />
            <span class="api-ic">
              <IconApiWebhook />
            </span>
            <span class="api-card-body">
              <span class="api-card-label">Webhook</span>
              <span class="api-card-sub">Оновлення в реалтаймі</span>
            </span>
          </div>
        </div>
        <div class="api-node">
          <DottedBorder color="#7A7A7A" gap={4} />
          <span class="api-ic">
            <IconApiShiftClose />
          </span>
          Закриття зміни
        </div>
        <div class="api-logo">
          <ApiLogo />
        </div>
      </div>
    </div>
  </section>

  <Support />

  <Blog />

  <News />

  <section class="faq">
    <div class="container faq-inner">
      <p class="subtitle">FAQ</p>
      <h2>Поширені запитання</h2>
      <FaqBoy class="faq-boy" aria-hidden="true" />
      <FaqCup class="faq-cup" aria-hidden="true" />
      <Faq items={faqItems} />
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { playWhileVisible } from "@scripts/motion";

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  // Hero receipt counter: steps once a second by the per-second rate
  // (e.g. +33), and only while the counter is on screen

  const receiptCounter = document.querySelector<HTMLElement>(
    "[data-receipt-counter]"
  );
  if (receiptCounter) {
    const base = Number(receiptCounter.dataset.base);
    const baseAt = Number(receiptCounter.dataset.baseAt);
    const perSecond = Number(receiptCounter.dataset.perSecond);
    const update = () => {
      const elapsedSeconds = Math.floor((Date.now() - baseAt) / 1000);
      receiptCounter.textContent = String(
        base + elapsedSeconds * perSecond
      ).replace(/\B(?=(\d{3})+(?!\d))/g, "\u00a0");
    };

    let timer = 0;
    new IntersectionObserver(([entry]) => {
      clearInterval(timer);
      if (!entry.isIntersecting) return;
      update();
      timer = window.setInterval(update, 1000);
    }).observe(receiptCounter);
  }

  // API //

  const apiFlow = document.querySelector(".api-flow");
  if (apiFlow) {
    const apiNodes = [
      ...apiFlow.querySelectorAll(".api-node, .api-card, .api-row, .api-logo"),
    ];
    const clearApi = () =>
      apiNodes.forEach((n) => n.classList.remove("is-active"));

    if (reducedMotion) {
      apiNodes.forEach((n) => n.classList.add("is-active"));
    } else {
      const apiTl = gsap.timeline({
        repeat: -1,
        repeatDelay: 1.8,
        paused: true,
      });
      apiTl.call(clearApi);
      apiNodes.forEach((n) => {
        apiTl.call(() => n.classList.add("is-active"), [], "+=.5");
      });

      playWhileVisible(apiTl, apiFlow);
    }
  }
</script>
