<script>
  import { gsap } from "gsap";

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  // Shared "pop" for small UI pieces — offline-queue rows, route cards and
  // dots, parcel rows: they grow to full size with one soft overshoot.
  // Change it here to retune every small pop on the page at once.
  const POP = { duration: 0.35, ease: "back.out(2)" };

  // Hero receipt counter: steps once a second by the per-second rate
  // (e.g. +33), and only while the counter is on screen

  const receiptCounter = document.querySelector<HTMLElement>(
    "[data-receipt-counter]"
  );
  if (receiptCounter) {
    const base = Number(receiptCounter.dataset.base);
    const baseAt = Number(receiptCounter.dataset.baseAt);
    const perSecond = Number(receiptCounter.dataset.perSecond);
    const update = () => {
      const elapsedSeconds = Math.floor((Date.now() - baseAt) / 1000);
      receiptCounter.textContent = String(
        base + elapsedSeconds * perSecond
      ).replace(/\B(?=(\d{3})+(?!\d))/g, "\u00a0");
    };

    let timer = 0;
    new IntersectionObserver(([entry]) => {
      clearInterval(timer);
      if (!entry.isIntersecting) return;
      update();
      timer = window.setInterval(update, 1000);
    }).observe(receiptCounter);
  }

  const loops = new Map<Element, gsap.core.Timeline>();

  const resizeHandlers: Array<() => void> = [];
  let resizeTimer: number;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(
      () => resizeHandlers.forEach((handler) => handler()),
      200
    );
  });

  // 1-line animation in reasons section

  const scaleBlock = document.querySelector(".reason-wrapper");
  const queueItems = [...document.querySelectorAll(".reason-offline-list li")];

  if (scaleBlock && queueItems.length) {
    // Line 1 timing, in seconds
    const timing = {
      cycleDelay: 2, // pause before the loop starts over
      terminalPop: 0.5, // one terminal popping into its slot
      terminalGap: 0.5, // between terminals
      queueStep: 0.5, // between queue rows turning "sent"
    };

    const setQueueState = (li: Element, state: string, badgeText: string) => {
      li.classList.remove("is-syncing", "is-done");
      if (state) li.classList.add(state);
      li.querySelector(".reasons-badge")!.textContent = badgeText;
    };

    const resetQueue = () => {
      setQueueState(queueItems[0], "is-done", "Відправлено");
      setQueueState(queueItems[1], "is-syncing", "Синхронізація");
      queueItems.slice(2).forEach((li) => setQueueState(li, "", "У черзі"));
      gsap.set(queueItems, { scale: 1 });
    };

    if (reducedMotion) {
      gsap.set(".reason-scale-slot .reason-scale", { scale: 1 });
      queueItems.forEach((li) => setQueueState(li, "is-done", "Відправлено"));
    } else {
      const tl = gsap.timeline({
        repeat: -1,
        repeatDelay: timing.cycleDelay,
        paused: true,
      });

      tl.call(resetQueue)
        // 1. terminals pop into the slots one by one
        .fromTo(
          ".reason-scale-slot .reason-scale",
          { scale: 0 },
          {
            scale: 1,
            duration: timing.terminalPop,
            ease: "back.out(1.2)",
            stagger: timing.terminalGap,
          }
        );

      // 2. then the queue advances one row at a time
      queueItems.slice(1).forEach((li, idx) => {
        tl.call(
          () => {
            setQueueState(li, "is-done", "Відправлено");
            const next = queueItems[idx + 2];
            if (next) setQueueState(next, "is-syncing", "Синхронізація");
          },
          [],
          `+=${timing.queueStep}`
        );

        tl.fromTo(
          li,
          { scale: 0.92, transformOrigin: "left center" },
          { scale: 1, ...POP },
          "<"
        );
      });

      // on mobile the terminals and the queue sit in different cards —
      // keep playing while either of them is on screen
      loops.set(scaleBlock, tl);
      loops.set(queueItems[0].parentElement!, tl);
    }
  }

  // 2-nd line of animation(grid and curier timeline)
 
  const companiesGrid = document.querySelector(".reason-companies");
  const routeList = document.querySelector(".reason-timeline");

  if (companiesGrid && routeList) {
    // Line 2 timing, in seconds
    const timing = {
      cycleDelay: 1.6, // pause before the loop starts over
      columnStep: 0.35, // grid: the next column lights up
      columnHold: 0.55, // grid: how long a column stays lit
      firstStop: 0.45, // route: wait before the first stop
      stopStep: 0.6, // route: between stops
    };

    const items = [...companiesGrid.querySelectorAll("li")];
    const stops = [...routeList.querySelectorAll("li")];

    const clearAll = () =>
      items.forEach((li) => li.classList.remove("is-active"));

    const setStep = (c: number) => {
      stops.forEach((li, k) => {
        li.classList.remove("is-current", "is-active", "is-done");
        if (k === c) li.classList.add("is-current");
        else if (k === c - 1) li.classList.add("is-active");
        else if (k < c - 1) li.classList.add("is-done");
      });
    };

    if (reducedMotion) {
      stops.forEach((li) => li.classList.add("is-done"));
    } else {
      let comboTl: gsap.core.Timeline;

      const build = () => {
        if (comboTl) comboTl.kill();
        clearAll();
        gsap.set(stops, { scale: 1 });
        gsap.set(
          stops.map((li) => li.querySelector(".reason-timeline-dot")),
          { scale: 1 }
        );

        const byLeft = new Map<number, Element[]>();
        items.forEach((li) => {
          const left = Math.round(li.getBoundingClientRect().left);
          if (!byLeft.has(left)) byLeft.set(left, []);
          byLeft.get(left)!.push(li);
        });
        const columns = [...byLeft.entries()]
          .sort((a, b) => a[0] - b[0])
          .map(([, cols]) => cols);

        comboTl = gsap.timeline({
          repeat: -1,
          repeatDelay: timing.cycleDelay,
          paused: true,
        });

        comboTl.call(() => setStep(-1), [], 0);

        columns.forEach((col, i) => {
          comboTl.call(
            () => col.forEach((li) => li.classList.add("is-active")),
            [],
            i * timing.columnStep
          );
          comboTl.call(
            () => col.forEach((li) => li.classList.remove("is-active")),
            [],
            i * timing.columnStep + timing.columnHold
          );
        });

        for (let c = 0; c <= stops.length + 1; c++) {
          comboTl.call(
            () => setStep(c),
            [],
            `+=${c === 0 ? timing.firstStop : timing.stopStep}`
          );

          const target = stops[c - 1];
          if (target) {
            const card = target.querySelector(".reason-timeline-card");
            const dot = target.querySelector(".reason-timeline-dot");

            if (card) {
              comboTl.fromTo(
                card,
                { scale: 0.85, transformOrigin: "left center" },
                { scale: 1, ...POP, immediateRender: false },
                "<"
              );
            }

            // the dot starts smaller than its card: a 16px dot needs more
            // travel for the same pop to read
            if (dot) {
              comboTl.fromTo(
                dot,
                { scale: 0.6, transformOrigin: "center center" },
                { scale: 1, ...POP, immediateRender: false },
                "<"
              );
            }
          }
        }

        // grid and route are separate cards on mobile: watch both
        loops.set(companiesGrid, comboTl);
        loops.set(routeList, comboTl);
      };

      build();

      resizeHandlers.push(() => {
        build();
        comboTl.play();
      });
    }
  }

  // Post list

  const postList = document.querySelector(".reason-post-list");
  if (postList) {
    // Line 3 timing, in seconds
    const timing = {
      cycleDelay: 2, // pause before the loop starts over
      rowStep: 0.5, // between parcels turning "delivered"
    };

    const rows = [...postList.querySelectorAll("li")];

    const setPostState = (li: Element, done: boolean) => {
      li.classList.toggle("is-done", done);
      const status = li.querySelector(".reason-post-status")!;
      status.textContent = done
        ? "Доставлено"
        : (status.getAttribute("data-status") ?? "");
    };

    const resetPost = () => {
      rows.forEach((li) => setPostState(li, false));
      gsap.set(rows, { scale: 1 });
    };

    if (reducedMotion) {
      rows.forEach((li) => setPostState(li, true));
    } else {
      const postTl = gsap.timeline({
        repeat: -1,
        repeatDelay: timing.cycleDelay,
        paused: true,
      });

      postTl.call(resetPost);

      rows.forEach((li) => {
        postTl.call(() => setPostState(li, true), [], `+=${timing.rowStep}`);

        postTl.fromTo(
          li,
          { scale: 0.92, transformOrigin: "left center" },
          { scale: 1, ...POP, immediateRender: false },
          "<"
        );
      });

      loops.set(postList, postTl);
    }
  }

  // Steps

  const stepsGrid = document.querySelector(".steps-grid");
  if (stepsGrid) {
    const cards = [...stepsGrid.querySelectorAll<HTMLElement>(".step-card")];
    const fillsOf = (card: HTMLElement) => [
      ...card.querySelectorAll<HTMLElement>("[data-fill], [data-activate]"),
    ];
    // Steps timing, in seconds
    const timing = {
      cycleDelay: 2.5, // pause before the loop starts over
      cardStep: 0.6, // pause before the next card becomes active
      fillStep: 0.25, // start-to-start gap between fields: pops overlap
      receiptGlow: 0.2, // card 4: wait before its receipt frame lights up
      finalHold: 0.35, // wait before the last card is marked done
    };

    const fillClass = (el: HTMLElement) =>
      el.hasAttribute("data-activate") ? "is-active" : "is-filled";

    const reset = () => {
      cards.forEach((card) => {
        card.classList.remove("is-active", "is-done", "is-filled-done");
        fillsOf(card).forEach((el) => {
          el.classList.remove("is-filled", "is-active");
          gsap.set(el, { scale: 1 });
        });
      });
    };

    if (reducedMotion) {
      cards.forEach((card) => {
        card.classList.add("is-done", "is-filled-done");
        fillsOf(card).forEach((el) => el.classList.add(fillClass(el)));
      });
    } else {
      const stepsTl = gsap.timeline({
        repeat: -1,
        repeatDelay: timing.cycleDelay,
        paused: true,
      });

      stepsTl.call(reset);

      cards.forEach((card, i) => {
        stepsTl.call(
          () => {
            cards.forEach((c, k) => {
              c.classList.toggle("is-active", c === card);
              c.classList.toggle("is-done", k < i);
            });
          },
          [],
          `+=${timing.cardStep}`
        );

        // "<" + gap = counted from the START of the previous pop, so the
        // next field begins while the last one is still settling
        fillsOf(card).forEach((el) => {
          stepsTl.call(
            () => el.classList.add(fillClass(el)),
            [],
            `<${timing.fillStep}`
          );

          stepsTl.fromTo(
            el,
            { scale: 0.92, transformOrigin: "left center" },
            { scale: 1, ...POP },
            "<"
          );
        });

        if (card.dataset.card === "4") {
          stepsTl.call(
            () => card.classList.add("is-filled-done"),
            [],
            `+=${timing.receiptGlow}`
          );
        }
      });

      stepsTl.call(
        () => cards[cards.length - 1].classList.add("is-done"),
        [],
        `+=${timing.finalHold}`
      );

      loops.set(stepsGrid, stepsTl);
    }
  }

  // Slider testimonials

  const testimonialsSection =
    document.querySelector<HTMLElement>(".testimonials");
  if (testimonialsSection) {
    const track = testimonialsSection.querySelector<HTMLElement>(
      ".testimonials-track"
    )!;

    const realCards = [
      ...track.querySelectorAll<HTMLElement>(".testimonials-card"),
    ];

    const dedupeIds = (root: HTMLElement) => {
      const suffix = `-clone-${Math.random().toString(36).slice(2, 8)}`;
      root.querySelectorAll<HTMLElement>("[id]").forEach((el) => {
        const oldId = el.id;
        const newId = oldId + suffix;
        el.id = newId;
        root
          .querySelectorAll(`[fill="url(#${oldId})"]`)
          .forEach((ref) => ref.setAttribute("fill", `url(#${newId})`));
        root
          .querySelectorAll(`[href="#${oldId}"]`)
          .forEach((ref) => ref.setAttribute("href", `#${newId}`));
      });
    };

    const hasLoop = realCards.length > 1;

    if (hasLoop) {
      const firstClone = realCards[0].cloneNode(true) as HTMLElement;
      const lastClone = realCards[realCards.length - 1].cloneNode(
        true
      ) as HTMLElement;

      [firstClone, lastClone].forEach((clone) => {
        clone.classList.add("is-clone");
        clone.setAttribute("aria-hidden", "true");
        clone
          .querySelectorAll<HTMLElement>("a, button")
          .forEach((el) => el.setAttribute("tabindex", "-1"));
        dedupeIds(clone);
      });

      track.insertBefore(lastClone, realCards[0]);
      track.appendChild(firstClone);
    }

    const cards = [
      ...track.querySelectorAll<HTMLElement>(".testimonials-card"),
    ];
    const bodies = cards.map(
      (card) => card.querySelector<HTMLElement>(".testimonials-body")!
    );
    const prevBtn =
      testimonialsSection.querySelector<HTMLButtonElement>(
        ".slider-btn--prev"
      )!;
    const nextBtn =
      testimonialsSection.querySelector<HTMLButtonElement>(
        ".slider-btn--next"
      )!;

    const desktop = window.matchMedia("(min-width: 1024px)");
    const PAD_ACTIVE = 16;
    const BODY_MARGIN = { top: 24, right: 40, bottom: 24, left: 24 };
    const ACTIVE_SHARE = 0.65;

    const FIRST_REAL = hasLoop ? 1 : 0;
    const LAST_REAL = hasLoop ? cards.length - 2 : cards.length - 1;

    let index = FIRST_REAL;
    let bodyW = 0;
    let step = 0;
    let isAnimating = false;
    // the card that is currently open on screen (index changes first)
    let shownIndex = index;

    const cardProps = (active: boolean) => ({
      padding: active ? PAD_ACTIVE : 16,
      backgroundColor: active ? "#ffffff" : "rgba(255,255,255,0)",
      borderColor: active ? "rgba(255,255,255,0)" : "rgba(255,255,255,0.35)",
    });
    const bodyProps = (active: boolean) => ({
      width: active ? bodyW : 0,
      marginTop: active ? BODY_MARGIN.top : 0,
      marginRight: active ? BODY_MARGIN.right : 0,
      marginBottom: active ? BODY_MARGIN.bottom : 0,
      marginLeft: active ? BODY_MARGIN.left : 0,
      autoAlpha: active ? 1 : 0,
    });

    const measure = () => {
      if (!desktop.matches) return;
      const mediaW = cards[0].querySelector<HTMLElement>(
        ".testimonials-media"
      )!.offsetWidth;
      const containerW = track.parentElement!.clientWidth;
      bodyW = Math.max(
        240,
        Math.round(containerW * ACTIVE_SHARE) -
          (PAD_ACTIVE * 2 + BODY_MARGIN.left + BODY_MARGIN.right + mediaW)
      );
      testimonialsSection.style.setProperty("--body-w", `${bodyW}px`);
      for (let k = 0; k < cards.length - 1; k++) {
        if (k !== index && k + 1 !== index) {
          step = cards[k + 1].offsetLeft - cards[k].offsetLeft;
          break;
        }
      }
    };

    const apply = (animate: boolean, onDone?: () => void) => {
      const instant = reducedMotion || !animate;
      const tween: gsap.TweenVars = {
        duration: 1,
        ease: "expo.inOut",
        overwrite: true,
      };

      if (desktop.matches) {
        cards.forEach((card, k) => {
          const active = k === index;
          if (instant) {
            gsap.set(card, cardProps(active));
            gsap.set(bodies[k], bodyProps(active));
          } else if (active || k === shownIndex) {
            // only the card that opens and the one that closes change —
            // tweening the rest would just restyle them every frame
            gsap.to(card, { ...cardProps(active), ...tween });
            gsap.to(bodies[k], { ...bodyProps(active), ...tween });
          }
        });
        const x = -index * step;
        if (instant) {
          gsap.set(track, { x });
        } else {
          gsap.to(track, { x, ...tween, onComplete: onDone });
        }
      } else {
        const x = -(cards[index].offsetLeft - cards[0].offsetLeft);
        if (instant) {
          gsap.set(track, { x });
        } else {
          gsap.to(track, { x, ...tween, onComplete: onDone });
        }
      }

      cards.forEach((card, k) => {
        const current = k === index;
        card.classList.toggle("is-current", current);
        // only the open card's link is reachable by Tab; collapsed and
        // off-screen cards are hidden from assistive tech too
        if (!card.classList.contains("is-clone")) {
          card.toggleAttribute("aria-hidden", !current);
          card
            .querySelectorAll<HTMLElement>("a, button")
            .forEach((el) => (el.tabIndex = current ? 0 : -1));
        }
      });
      shownIndex = index;

      if (instant) onDone?.();
    };

    const goTo = (i: number, animate = true) => {
      if (isAnimating) return;
      index = i;

      const finalize = () => {
        if (hasLoop && index === 0) {
          index = LAST_REAL;
          apply(false);
        }
        else if (hasLoop && index === cards.length - 1) {
          index = FIRST_REAL;
          apply(false);
        }
        isAnimating = false;
      };

      if (animate && !reducedMotion) isAnimating = true;
      apply(animate, finalize);
    };

    const init = () => {
      apply(false);
      measure();
      apply(false);
    };

    prevBtn.addEventListener("click", () => goTo(index - 1));
    nextBtn.addEventListener("click", () => goTo(index + 1));

    cards.forEach((card, k) =>
      card.addEventListener("click", () => {
        if (desktop.matches && k !== index && !isAnimating) goTo(k);
      })
    );

    let touchX = 0;
    track.addEventListener(
      "touchstart",
      (e) => (touchX = e.touches[0].clientX),
      { passive: true }
    );
    track.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 40) goTo(index + (dx < 0 ? 1 : -1));
      },
      { passive: true }
    );

    resizeHandlers.push(() => {
      gsap.set([track, ...cards, ...bodies], { clearProps: "all" });
      init();
    });

    init();

    if (!reducedMotion) {
      // opacity, not autoAlpha: visibility:hidden would make the card links
      // unreachable by Tab until the section had been scrolled into view
      gsap.set(cards, { y: 48, opacity: 0 });
      const playIntro = () => {
        introObserver.disconnect();
        gsap.to(cards, {
          y: 0,
          opacity: 1,
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.12,
        });
      };
      const introObserver = new IntersectionObserver(
        (entries) => entries[0].isIntersecting && playIntro(),
        { threshold: 0.2 }
      );
      // watch the track's container, not the track: the slider shifts the
      // track sideways (on mobile almost all of its box sits off-screen to
      // the left), so the track itself never looked 20% visible
      introObserver.observe(track.parentElement!);
      // tabbing straight into the slider also reveals it
      track.addEventListener("focusin", playIntro, { once: true });
    }
  }

  // API //

  const apiFlow = document.querySelector(".api-flow");
  if (apiFlow) {
    const apiNodes = [
      ...apiFlow.querySelectorAll(".api-node, .api-card, .api-row, .api-logo"),
    ];
    const clearApi = () =>
      apiNodes.forEach((n) => n.classList.remove("is-active"));

    if (reducedMotion) {
      apiNodes.forEach((n) => n.classList.add("is-active"));
    } else {
      const apiTl = gsap.timeline({
        repeat: -1,
        repeatDelay: 1.8,
        paused: true,
      });
      apiTl.call(clearApi);
      apiNodes.forEach((n) => {
        apiTl.call(() => n.classList.add("is-active"), [], "+=.5");
      });

      loops.set(apiFlow, apiTl);
    }
  }

  // Category slider

  const categorySection = document.querySelector<HTMLElement>(".category");
  if (categorySection) {
    const tabs = [
      ...categorySection.querySelectorAll<HTMLButtonElement>(".category-tab"),
    ];
    const panelText = categorySection.querySelector<HTMLElement>(
      ".category-panel-text"
    )!;
    const panelAuthorName = categorySection.querySelector<HTMLElement>(
      ".category-panel-author-name"
    )!;
    const panelRole = categorySection.querySelector<HTMLElement>(
      ".category-panel-role"
    )!;
    const panelLogos = categorySection.querySelector<HTMLElement>(
      ".category-panel-logos"
    )!;
    const prevBtn =
      categorySection.querySelector<HTMLButtonElement>(".slider-btn--prev")!;
    const nextBtn =
      categorySection.querySelector<HTMLButtonElement>(".slider-btn--next")!;

    let index = Math.max(
      0,
      tabs.findIndex((tab) => tab.classList.contains("is-active"))
    );
    let categoryTl: gsap.core.Timeline | undefined;

    const tabList = categorySection.querySelector<HTMLElement>(".category-tabs")!;
    const panelCopy = [
      categorySection.querySelector<HTMLElement>(".category-panel-quote")!,
      panelLogos,
    ];
    let panelImage = categorySection.querySelector<HTMLImageElement>(
      ".category-panel-image"
    )!;
    // bumped on every switch, so a slow image decode from an older click
    // can't overwrite a newer one
    let renderToken = 0;

    // Builds a detached <img> for a tab and resolves once it is decoded,
    // so it can be shown without a blank frame or a progressive paint
    const loadImage = (tab: HTMLElement) => {
      const { image, srcset, imageW, imageH } = tab.dataset;
      const img = panelImage.cloneNode() as HTMLImageElement;
      img.loading = "eager";
      img.srcset = srcset ?? "";
      img.src = image!;
      img.width = Number(imageW);
      img.height = Number(imageH);
      return img.decode().then(
        () => img,
        () => img
      );
    };

    const markLogoOverflow = () =>
      panelLogos.classList.toggle(
        "is-overflowing",
        panelLogos.scrollWidth > panelLogos.clientWidth
      );
    markLogoOverflow();
    resizeHandlers.push(markLogoOverflow);

    const renderCopy = (tab: HTMLElement) => {
      const { quote, author, role, logos } = tab.dataset;
      panelText.textContent = quote!;
      panelAuthorName.textContent = author!;
      panelRole.textContent = role!;
      panelLogos.replaceChildren(
        ...logos!.split("|").map((label) => {
          const li = document.createElement("li");
          li.textContent = label;
          return li;
        })
      );
      markLogoOverflow();
    };

    // Scroll only the tab strip (mobile) — scrollIntoView would also scroll
    // the window and yank the page while the autoplay runs
    const centerTab = (tab: HTMLElement, smooth = !reducedMotion) => {
      if (tabList.scrollWidth <= tabList.clientWidth) return;
      const listBox = tabList.getBoundingClientRect();
      const tabBox = tab.getBoundingClientRect();
      tabList.scrollTo({
        left:
          tabList.scrollLeft +
          (tabBox.left - listBox.left) -
          (listBox.width - tabBox.width) / 2,
        behavior: smooth ? "smooth" : "auto",
      });
    };

    // the initially active tab sits off-screen in the mobile strip
    centerTab(tabs[index], false);

    const show = async (tab: HTMLElement) => {
      const token = ++renderToken;
      const nextImage = await loadImage(tab);
      if (token !== renderToken) return;

      if (reducedMotion) {
        panelImage.replaceWith(nextImage);
        panelImage = nextImage;
        renderCopy(tab);
        return;
      }

      // crossfade: the new photo rises and fades in on top of the old one,
      // which is removed once covered — the panel never flashes to black
      const prevImage = panelImage;
      gsap.set(nextImage, { autoAlpha: 0, y: 10 });
      prevImage.after(nextImage);
      panelImage = nextImage;
      gsap.to(nextImage, {
        autoAlpha: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
        onComplete: () => prevImage.remove(),
      });

      gsap.to(panelCopy, {
        autoAlpha: 0,
        y: -8,
        duration: 0.2,
        ease: "power2.in",
        overwrite: true,
        onComplete: () => {
          if (token !== renderToken) return;
          renderCopy(tab);
          gsap.fromTo(
            panelCopy,
            { autoAlpha: 0, y: 8 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.4,
              ease: "power2.out",
              stagger: 0.06,
              overwrite: true,
            }
          );
        },
      });
    };

    const panel = categorySection.querySelector<HTMLElement>(".category-panel")!;

    const activate = (next: number, userTriggered = false) => {
      index = (next + tabs.length) % tabs.length;
      tabs.forEach((tab, k) => {
        const active = k === index;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", String(active));
        // roving tabindex: only the selected tab is a Tab stop
        tab.tabIndex = active ? 0 : -1;
      });
      panel.setAttribute("aria-labelledby", tabs[index].id);
      // announce the new quote only when the visitor switched it — the
      // autoplay changing it every few seconds would be noise
      panel.setAttribute("aria-live", userTriggered ? "polite" : "off");
      centerTab(tabs[index]);
      show(tabs[index]);
      // warm the cache for the autoplay's next slide
      loadImage(tabs[(index + 1) % tabs.length]);

      if (userTriggered) {
        categoryTl?.pause();
        loops.delete(categorySection);
      }
    };

    tabs.forEach((tab, i) =>
      tab.addEventListener("click", () => activate(i, true))
    );
    prevBtn.addEventListener("click", () => activate(index - 1, true));
    nextBtn.addEventListener("click", () => activate(index + 1, true));

    // keyboard: arrows move between tabs (and select them), Home/End jump
    // to the ends — the WAI-ARIA tabs pattern
    tabList.addEventListener("keydown", (e) => {
      const keys: Record<string, number> = {
        ArrowRight: index + 1,
        ArrowDown: index + 1,
        ArrowLeft: index - 1,
        ArrowUp: index - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(e.key in keys)) return;
      e.preventDefault();
      activate(keys[e.key], true);
      tabs[index].focus({ preventScroll: true });
    });

    // swipe the photo panel on touch screens, like the testimonials
    let touchX = 0;
    panel.addEventListener(
      "touchstart",
      (e) => (touchX = e.touches[0].clientX),
      { passive: true }
    );
    panel.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 40) activate(index + (dx < 0 ? 1 : -1), true);
      },
      { passive: true }
    );

    if (!reducedMotion) {
      categoryTl = gsap.timeline({ repeat: -1, paused: true });
      categoryTl.call(() => activate(index + 1), [], 4);
      loops.set(categorySection, categoryTl);

      // hold the autoplay while the visitor points at or tabs into the
      // slider, so a quote doesn't change mid-read (WCAG 2.2.2)
      let hovered = false;
      let focused = false;
      const sync = () => {
        if (!loops.has(categorySection)) return; // stopped for good
        hovered || focused ? categoryTl!.pause() : categoryTl!.play();
      };
      const slider = categorySection.querySelector<HTMLElement>(".category-slider")!;
      slider.addEventListener("mouseenter", () => ((hovered = true), sync()));
      slider.addEventListener("mouseleave", () => ((hovered = false), sync()));
      slider.addEventListener("focusin", () => ((focused = true), sync()));
      slider.addEventListener("focusout", (e) => {
        if (slider.contains(e.relatedTarget as Node)) return;
        focused = false;
        sync();
      });
    }
  }

  // A loop plays while ANY of its parts is in the middle 80% of the screen.
  // No "30% visible" threshold: on mobile some blocks (steps) are taller
  // than three screens and would never reach it, freezing mid-animation.
  if (loops.size) {
    const onScreen = new Set<Element>();
    const loopObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) =>
          entry.isIntersecting
            ? onScreen.add(entry.target)
            : onScreen.delete(entry.target)
        );
        // only touch the timelines whose parts just changed, so other
        // pauses (e.g. category hover) are left alone
        new Set(entries.map((entry) => loops.get(entry.target))).forEach(
          (timeline) => {
            if (!timeline) return;
            const visible = [...loops].some(
              ([el, tl]) => tl === timeline && onScreen.has(el)
            );
            visible ? timeline.play() : timeline.pause();
          }
        );
      },
      { rootMargin: "-10% 0px" }
    );
    loops.forEach((_, el) => loopObserver.observe(el));
  }
</script>
